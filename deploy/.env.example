# Database
DATABASE_URL=sqlite+aiosqlite:///data/oxly.db

# Security
SECRET_KEY=change_this_in_production_please_it_is_very_insecure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dashboard (only needed for standalone `npm run dev` against a separately
# running api; the merged app serves the dashboard same-origin otherwise)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/traces

# Environment
ENVIRONMENT=development
