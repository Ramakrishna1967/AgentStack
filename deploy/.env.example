ACCESS_TOKEN_EXPIRE_MINUTES=30

# Collector
COLLECTOR_PORT=4318
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Dashboard
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/traces

# Environment
ENVIRONMENT=development
